# /etc/drone-detector.env — read by drone-detector.service. No secrets.

# Capture adapter (USB Wi-Fi that supports monitor mode). Empty = first wireless interface
# that is not HOTSPOT_IFACE. The hotspot interface is never touched.
WIFI_IFACE=
HOTSPOT_IFACE=wlan0
# Channel hopping: explicit list (e.g. 1,6,11,149,153,157,161) or bands for the default plan
WIFI_CHANNELS=
WIFI_BANDS=2.4,5
HOP_DWELL=0.3

# Bluetooth LE Remote ID on the Pi's onboard Bluetooth (0 to disable)
BLE_SCAN=1
BLE_ADAPTER=

# Web UI. NOTE: OpenTAKServer's nginx also listens on 8080 (Marti HTTP). If OTS is installed,
# set another port here (see README) until the platform renumbers.
WEB_PORT=8080

# CoT output (OpenTAKServer TCP on this Pi)
TAK_HOST=127.0.0.1
TAK_PORT=8087
# Where this sensor is, so detections without GPS (OUI/SSID only) can be placed near it.
# Leave empty and such detections are not put on the map.
SENSOR_LAT=
SENSOR_LON=
# Affiliation for confirmed drones: h (hostile, default) or u (unknown)
COT_AFFILIATION=h

# SIMULATE=1 runs with fake detections (callsigns prefixed SIM-)
SIMULATE=0
# Extra arguments for python -m detector, e.g. --no-ble or --no-cot
DETECTOR_ARGS=
