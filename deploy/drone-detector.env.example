# /etc/drone-detector.env — read by drone-detector.service. No secrets.

# Capture adapter (USB Wi-Fi that supports monitor mode). Empty = first wireless interface
# that is not HOTSPOT_IFACE. The hotspot interface is never touched.
WIFI_IFACE=
HOTSPOT_IFACE=wlan0
# Channel hopping: explicit list (e.g. 1,6,11,149,153,157,161) or bands for the default plan
WIFI_CHANNELS=
WIFI_BANDS=2.4,5
HOP_DWELL=0.3

# Bluetooth LE Remote ID on the Pi's onboard Bluetooth (0 to disable)
BLE_SCAN=1
BLE_ADAPTER=

# Web UI (kit port plan: 8060; 8080 belongs to OpenTAKServer's nginx)
WEB_PORT=8060

# CoT output (OpenTAKServer TCP on this Pi)
TAK_HOST=127.0.0.1
TAK_PORT=8087
# Shared OP position (kit contract C4.2: the same SENSOR_LAT/SENSOR_LON in every tool's env file).
# Detections without GPS (OUI/SSID only) are placed near it. Leave empty and such detections are not
# put on the map (never at 0,0); the dashboard shows "position not set".
SENSOR_LAT=
SENSOR_LON=
# Affiliation for confirmed drones: h (hostile, default) or u (unknown)
COT_AFFILIATION=h

# Mesh alerts for NEW drone detections on meshbus/tx (at most one text per 30 s, bursts aggregated)
MESH_ALERTS=1

# Heartbeat (isrkit/heartbeat/drone-detector every 10 s) via the Pi's broker. Off the Pi use the isrkit user.
# ISR_HOST names this station in the heartbeat (default: lowercased short hostname).
ISR_HOST=
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=guest
MQTT_PASS=guest
HEARTBEAT=1

# SIMULATE=1 plays the scripted demo scenario around SENSOR_LAT/LON (callsigns SIM-, remarks SIMULATED:,
# mesh texts [SIM])
SIMULATE=0
# Extra arguments for python -m detector, e.g. --no-ble or --no-cot
DETECTOR_ARGS=
